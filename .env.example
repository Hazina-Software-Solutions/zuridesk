# Safe placeholders only. Copy to .env.local and obtain real values through an approved secret channel.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4000
LOG_LEVEL=info
MONGODB_URI=mongodb://127.0.0.1:27018/?replicaSet=rs0&directConnection=true
MONGODB_DB_NAME=zuridesk_development
WEB_ORIGINS=http://localhost:3000
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# Generate separate values through an approved secret channel. Never reuse keys across purposes.
JWT_ISSUER=https://api.example.invalid
JWT_AUDIENCE=zuridesk
JWT_CURRENT_KID=replace-me
JWT_PRIVATE_KEY_B64=replace-with-base64-pkcs8
JWT_PUBLIC_KEYS_B64_JSON={"replace-me":"replace-with-base64-spki"}
AUTH_REFRESH_KEY_VERSION=v1
AUTH_REFRESH_KEYS_JSON={"v1":"replace-with-at-least-32-random-characters"}
AUTH_CHALLENGE_KEY_VERSION=v1
AUTH_CHALLENGE_KEYS_JSON={"v1":"replace-with-at-least-32-random-characters"}
AUTH_INVITE_KEY_VERSION=v1
AUTH_INVITE_KEYS_JSON={"v1":"replace-with-at-least-32-random-characters"}
AUTH_CSRF_KEY_VERSION=v1
AUTH_CSRF_KEYS_JSON={"v1":"replace-with-at-least-32-random-characters"}
AUTH_SUBJECT_KEY_VERSION=v1
AUTH_SUBJECT_KEYS_JSON={"v1":"replace-with-at-least-32-random-characters"}
# capture is allowed only for explicitly enabled local development/test workflows.
AUTH_DELIVERY_MODE=unconfigured
