{
  "name": "@zuridesk/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./seeding": "./src/seeding.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "migrate": "node ../../scripts/run-with-root-env.mjs tsx scripts/migrate.ts",
    "migration:status": "node ../../scripts/run-with-root-env.mjs tsx scripts/migration-status.ts",
    "seed": "node ../../scripts/run-with-root-env.mjs tsx scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "@zuridesk/shared": "workspace:*",
    "mongoose": "9.10.4"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
